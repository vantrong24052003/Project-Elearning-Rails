<div class="container mx-auto px-4 py-8 bg-white dark:bg-gray-900 text-gray-800 dark:text-white" data-controller="dashboard--quiz-index">
  <div class="mb-6">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">
        Bài kiểm tra - <%= @course.title %>
      </h1>

      <button onclick="quiz_stats_modal.showModal()" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 dark:bg-purple-600 dark:hover:bg-purple-700 text-white text-sm rounded-lg  flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        Thống kê bài kiểm tra
      </button>
    </div>

    <p class="text-gray-600 dark:text-gray-300 max-w-3xl">
      Hoàn thành các bài kiểm tra để đánh giá kiến thức của bạn và theo dõi tiến trình học tập.
      Mỗi bài kiểm tra có thời gian làm bài riêng, hãy cố gắng hoàn thành đúng thời gian quy định.
    </p>
  </div>

  <% if @available_quizzes.any? %>
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-5">Bài kiểm tra khả dụng</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 md:gap-6">
        <% @available_quizzes.each do |quiz| %>
          <div class="bg-white hover:bg-gray-50 dark:bg-gray-800 dark:hover:bg-gray-800/80 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <div class="p-4 md:p-6">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-3 md:mb-4 gap-2">
                <h3 class="text-lg md:text-xl font-semibold text-gray-900 dark:text-white break-words" title="<%= quiz.title %>">
                  <%= quiz.title %>
                  <% if quiz.exam? %>
                    <span class="inline-block ml-2 px-2 py-1 text-xs font-semibold rounded-full bg-red-100 dark:bg-red-500/80 text-red-700 dark:text-white whitespace-nowrap">
                      Bài thi
                    </span>
                  <% else %>
                    <span class="inline-block ml-2 px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 dark:bg-purple-500 text-blue-700 dark:text-white whitespace-nowrap">
                      Bài kiểm tra
                    </span>
                  <% end %>
                </h3>

                <div class="flex flex-wrap items-center gap-2">
                  <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300 whitespace-nowrap flex-shrink-0">
                    <%= quiz.status_label %>
                  </span>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row sm:flex-wrap items-start sm:items-center gap-2 sm:gap-3 md:gap-6 mb-4 text-gray-600 dark:text-gray-300 text-sm md:text-base">
                <div class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 mr-2 text-blue-500 dark:text-purple-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span class="whitespace-nowrap"><%= quiz.questions.count %> câu hỏi</span>
                </div>

                <div class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 mr-2 text-blue-500 dark:text-purple-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="whitespace-nowrap"><%= quiz.time_limit_display %></span>
                </div>
              </div>

              <% if quiz.start_time.present? || quiz.end_time.present? %>
                <div class="mb-4 text-gray-600 dark:text-gray-300 text-xs sm:text-sm space-y-1">
                  <% if quiz.start_time.present? %>
                    <div class="flex items-center">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 mr-2 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                      </svg>
                      <span class="break-words">Bắt đầu: <%= quiz.start_time.strftime("%d/%m/%Y %H:%M") %></span>
                    </div>
                  <% end %>
                  <% if quiz.end_time.present? %>
                    <div class="flex items-center">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 mr-2 text-red-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z" />
                      </svg>
                      <span class="break-words">Kết thúc: <%= quiz.end_time.strftime("%d/%m/%Y %H:%M") %></span>
                    </div>
                  <% end %>
                </div>
              <% end %>

              <div class="mt-4 md:mt-6">
                <% if current_user.has_role?(:admin) || current_user == @course.user || Enrollment.exists?(user: current_user, course: @course, status: :active) %>
                  <% already_attempted = QuizAttempt.exists?(quiz: quiz, user: current_user) %>
                  <% if already_attempted %>
                    <% latest_attempt = QuizAttempt.where(quiz: quiz, user: current_user).order(created_at: :desc).first %>
                    <%= link_to dashboard_course_quiz_quiz_attempt_path(@course, quiz, latest_attempt),
                        class: "w-full text-center px-3 py-2 md:px-4 md:py-2 bg-gray-600 hover:bg-gray-700 dark:bg-gray-600 dark:hover:bg-gray-700 text-white text-sm md:text-base rounded-lg transition block font-medium" do %>
                      Xem kết quả (<%= latest_attempt.score %>%)
                    <% end %>
                  <% else %>
                    <%= link_to dashboard_course_quiz_path(@course, quiz, start: true),
                          class: "w-full text-center px-3 py-2 md:px-4 md:py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm md:text-base rounded-lg transition block font-medium",
                          data: { quiz_id: quiz.id, quiz_type: quiz.exam? ? 'exam' : 'practice' } do %>
                        <%= quiz.exam? ? 'Làm bài thi' : 'Làm bài kiểm tra' %>
                      <% end %>
                  <% end %>
                <% else %>
                  <span class="w-full text-center px-3 py-2 md:px-4 md:py-2 bg-gray-400 text-white text-sm md:text-base rounded-lg block font-medium cursor-not-allowed">
                    Cần đăng ký khóa học
                  </span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if @available_quizzes.total_pages > 1 %>
        <div class="mt-6 flex justify-center">
          <%= render 'shared/pagination', collection: @available_quizzes %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @upcoming_quizzes.any? %>
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-5">Bài kiểm tra sắp mở</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 md:gap-6">
        <% @upcoming_quizzes.each do |quiz| %>
          <div class="bg-white hover:bg-gray-50 dark:bg-gray-800 dark:hover:bg-gray-800/80 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow opacity-75">
            <div class="p-4 md:p-6">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-3 md:mb-4 gap-2">
                <h3 class="text-lg md:text-xl font-semibold text-gray-900 dark:text-white break-words" title="<%= quiz.title %>">
                  <%= quiz.title %>
                  <% if quiz.exam? %>
                    <span class="inline-block ml-2 px-2 py-1 text-xs font-semibold rounded-full bg-red-100 dark:bg-red-500/80 text-red-700 dark:text-white whitespace-nowrap">
                      Bài thi
                    </span>
                  <% else %>
                    <span class="inline-block ml-2 px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 dark:bg-purple-500 text-blue-700 dark:text-white whitespace-nowrap">
                      Bài kiểm tra
                    </span>
                  <% end %>
                </h3>

                <div class="flex flex-wrap items-center gap-2">
                  <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300 whitespace-nowrap flex-shrink-0">
                    <%= quiz.status_label %>
                  </span>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row sm:flex-wrap items-start sm:items-center gap-2 sm:gap-3 md:gap-6 mb-4 text-gray-600 dark:text-gray-300 text-sm md:text-base">
                <div class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 mr-2 text-blue-500 dark:text-purple-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span class="whitespace-nowrap"><%= quiz.questions.count %> câu hỏi</span>
                </div>

                <div class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 mr-2 text-blue-500 dark:text-purple-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="whitespace-nowrap"><%= quiz.time_limit_display %></span>
                </div>
              </div>

              <% if quiz.start_time.present? %>
                <div class="mb-4 text-gray-600 dark:text-gray-300 text-xs sm:text-sm">
                  <div class="flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 mr-2 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                    </svg>
                    <span class="break-words">Bắt đầu: <%= quiz.start_time.strftime("%d/%m/%Y %H:%M") %></span>
                  </div>
                </div>
              <% end %>

              <div class="mt-4 md:mt-6">
                <span class="w-full text-center px-3 py-2 md:px-4 md:py-2 bg-gray-400 text-white text-sm md:text-base rounded-lg block font-medium cursor-not-allowed">
                  Mở từ <%= quiz.start_time.strftime("%d/%m/%Y %H:%M") %>
                </span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @expired_quizzes.any? %>
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-5">Bài kiểm tra đã kết thúc</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 md:gap-6">
        <% @expired_quizzes.each do |quiz| %>
          <div class="bg-white hover:bg-gray-50 dark:bg-gray-800 dark:hover:bg-gray-800/80 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow opacity-60">
            <div class="p-4 md:p-6">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-3 md:mb-4 gap-2">
                <h3 class="text-lg md:text-xl font-semibold text-gray-900 dark:text-white break-words" title="<%= quiz.title %>">
                  <%= quiz.title %>
                  <% if quiz.exam? %>
                    <span class="inline-block ml-2 px-2 py-1 text-xs font-semibold rounded-full bg-red-100 dark:bg-red-500/80 text-red-700 dark:text-white whitespace-nowrap">
                      Bài thi
                    </span>
                  <% else %>
                    <span class="inline-block ml-2 px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 dark:bg-purple-500 text-blue-700 dark:text-white whitespace-nowrap">
                      Bài kiểm tra
                    </span>
                  <% end %>
                </h3>

                <div class="flex flex-wrap items-center gap-2">
                  <span class="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300 whitespace-nowrap flex-shrink-0">
                    <%= quiz.status_label %>
                  </span>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row sm:flex-wrap items-start sm:items-center gap-2 sm:gap-3 md:gap-6 mb-4 text-gray-600 dark:text-gray-300 text-sm md:text-base">
                <div class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 mr-2 text-blue-500 dark:text-purple-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span class="whitespace-nowrap"><%= quiz.questions.count %> câu hỏi</span>
                </div>

                <div class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 mr-2 text-blue-500 dark:text-purple-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="whitespace-nowrap"><%= quiz.time_limit_display %></span>
                </div>
              </div>

              <% if quiz.end_time.present? %>
                <div class="mb-4 text-gray-600 dark:text-gray-300 text-xs sm:text-sm">
                  <div class="flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 mr-2 text-red-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z" />
                    </svg>
                    <span class="break-words">Kết thúc: <%= quiz.end_time.strftime("%d/%m/%Y %H:%M") %></span>
                  </div>
                </div>
              <% end %>

              <div class="mt-4 md:mt-6">
                <% if current_user.has_role?(:admin) || current_user == @course.user || Enrollment.exists?(user: current_user, course: @course, status: :active) %>
                  <% already_attempted = QuizAttempt.exists?(quiz: quiz, user: current_user) %>
                  <% if already_attempted %>
                    <% latest_attempt = QuizAttempt.where(quiz: quiz, user: current_user).order(created_at: :desc).first %>
                    <%= link_to dashboard_course_quiz_quiz_attempt_path(@course, quiz, latest_attempt),
                        class: "w-full text-center px-3 py-2 md:px-4 md:py-2 bg-gray-600 hover:bg-gray-700 dark:bg-gray-600 dark:hover:bg-gray-700 text-white text-sm md:text-base rounded-lg transition block font-medium" do %>
                      Xem kết quả (<%= latest_attempt.score %>%)
                    <% end %>
                  <% else %>
                    <span class="w-full text-center px-3 py-2 md:px-4 md:py-2 bg-gray-400 text-white text-sm md:text-base rounded-lg block font-medium cursor-not-allowed">
                      Đã kết thúc
                    </span>
                  <% end %>
                <% else %>
                  <span class="w-full text-center px-3 py-2 md:px-4 md:py-2 bg-gray-400 text-white text-sm md:text-base rounded-lg block font-medium cursor-not-allowed">
                    Cần đăng ký khóa học
                  </span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @available_quizzes.empty? && @upcoming_quizzes.empty? && @expired_quizzes.empty? %>
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-8 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-gray-400 dark:text-gray-600 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
      </svg>
      <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Hiện chưa có bài quiz nào khả dụng</h3>
      <p class="text-gray-600 dark:text-gray-400">Không có bài kiểm tra nào đang mở tại thời điểm này. Vui lòng quay lại sau.</p>
    </div>
  <% end %>

    <%= render 'stats_modal', stats: @stats, course: @course %>
</div>
